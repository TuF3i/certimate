{
  "$ns": "login",

  "form": {
    "username": {
      "label": "Username",
      "placeholder": "Username/Email"
    },
    "password": {
      "label": "Password",
      "placeholder": "Password"
    },
    "submit": {
      "button": "Log-in"
    }
  },

  "sso": {
    "divider": "or sign in with SSO",
    "sign_in_with": "Sign in with {{provider}}",
    "ldap": {
      "username": {
        "label": "Username",
        "placeholder": "LDAP username"
      },
      "password": {
        "label": "Password",
        "placeholder": "LDAP password"
      }
    }
  }
}
